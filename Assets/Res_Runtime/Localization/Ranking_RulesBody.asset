  m_EditorClassIdentifier: Hamdoku::Hamdoku.L10NSO
  id: 216
  chinese: "\u5b8c\u6210\u4e3b\u7ebf\u5173\u5361\uff0c\u6536\u96c6\u74dc\u5b50\u53c2\u4e0e\u6392\u540d\u3002\n\n\u699c\u5355\u540d\u6b21\u3001\u8d5b\u5b63\u65f6\u95f4\u548c\u5956\u52b1\u4ee5\u670d\u52a1\u7aef\u7ed3\u679c\u4e3a\u51c6\u3002\n\n\u76ee\u524d\u670d\u52a1\u5c1a\u672a\u63a5\u5165\u3002\u901a\u5173\u4e8b\u5b9e\u4f1a\u4fdd\u5b58\u5728\u672c\u5730\u5f85\u4e0a\u62a5\uff0c\u4e0d\u751f\u6210\u5728\u7ebf\u6392\u540d\u3002\n\n\u8ba1\u5206\u516c\u5f0f\u3001\u8d5b\u5b63\u5468\u671f\u53ca\u5177\u4f53\u5956\u52b1\u5c1a\u5f85\u786e\u8ba4\u3002"
  english: "Complete campaign puzzles and collect seeds to compete.\n\nRankings, season times and rewards are determined by the server.\n\nThe service is not connected yet. Clear events are saved locally for submission; online ranks are unavailable.\n\nScoring, season schedule and reward amounts await confirmation."
