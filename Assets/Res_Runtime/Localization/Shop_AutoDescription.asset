  chinese: "\u653e\u7f6e\u4ed3\u9f20\u540e\uff0c\u81ea\u52a8\u4e3a\u540c\u884c\u3001\u540c\u5217\u53ca\u76f8\u90bb\u683c\u6807\u8bb0\u53c9\u53f7\u3002\n\u6b64\u5904\u4ec5\u6f14\u793a\u89c4\u5219\uff0c\u4e0d\u4f1a\u89e3\u9501\u8d2d\u4e70\u6743\u76ca\u3002"
