  m_EditorClassIdentifier: Hamdoku::Hamdoku.L10NSO
  id: 328
  chinese: "\u5934\u50cf\u3001\u8fb9\u6846\u3001\u6635\u79f0\u548c\u5ea7\u53f3\u94ed\u4fdd\u5b58\u5728\u672c\u673a\u3002UID \u662f\u672c\u5730\u5b58\u6863\u6807\u8bc6\uff0c\u672a\u7ed1\u5b9a\u4e91\u7aef\u8d26\u53f7\u3002\n\n\u8fde\u7eed\u901a\u5173\u548c\u8fde\u7eed\u767b\u5f55\u5206\u522b\u7edf\u8ba1\uff1b\u4e3b\u52a8\u91cd\u5f00\u6216\u5931\u8d25\u4f1a\u4e2d\u65ad\u8fde\u7eed\u901a\u5173\u3002\u4e09\u9897\u79cd\u5b50\u901a\u5173\u6309\u6ee1\u751f\u547d\u5b8c\u6210\u8bb0\u5f55\u3002\n\n\u65e7\u5b58\u6863\u7f3a\u5931\u7684\u5386\u53f2\u4e0d\u4f1a\u8865\u9020\uff1a\u6807\u6709 + \u7684\u6570\u503c\u4ece\u672c\u6b21\u66f4\u65b0\u5f00\u59cb\u7d2f\u8ba1\uff0c\u5386\u53f2\u5f00\u59cb\u65e5\u671f\u4e0e\u5728\u7ebf\u7b2c 1 \u540d\u6b21\u6570\u663e\u793a\u4e3a\u672a\u77e5\u3002\n\n\u4f1a\u5458\u3001\u8d5b\u5b63\u53ca\u6392\u884c\u699c\u670d\u52a1\u5c1a\u672a\u63a5\u5165\uff0c\u4e0d\u4f1a\u53d1\u653e\u5bf9\u5e94\u7269\u54c1\u3002"
  english: "Your avatar, frame, nickname and motto are saved on this device. UID identifies this local save, without a cloud account.\n\nWin streak and login streak are tracked separately. Restarting or failing ends the win streak. A 3-seed clear finishes with full health.\n\nFor older saves, + counts start with this update. Missing start dates and online 1st-place wins remain unknown.\n\nMembership, season and ranking services are not connected; their items cannot be claimed."
